#!/usr/bin/env bash
# Matomo upgrader with runtime selector (host | docker-compose | docker)
# - Replaces files on host MATOMO_DIR
# - Runs ./console via host or docker exec / docker compose exec
# - Handles maintenance mode, backups, DB updates
# - Prompts for paths/service/container as needed

set -Eeuo pipefail
IFS=$'\n\t'

# ---- UI helpers --------------------------------------------------------------
bold() { printf '\033[1m%s\033[0m' "$*"; }
info() { printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$*"; }
step() { printf '%s %s\n' "$(bold "[STEP $1]")" "$2"; }
warn() { printf '!\x20%s\n' "$*"; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }
require_cmd() { command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }

prompt() {
  # prompt "Question" "default"
  local q="${1:-}" d="${2:-}" a
  if [[ -n "${CI:-}" ]]; then
    printf '%s\n' "${d}"
    return 0
  fi
  if [[ -n "${d}" ]]; then
    read -r -p "${q} [${d}]: " a || true
    printf '%s\n' "${a:-$d}"
  else
    read -r -p "${q}: " a || true
    printf '%s\n' "${a}"
  fi
}

# ---- Matomo dir checks -------------------------------------------------------
is_matomo_dir() {
  [[ -d "$1" && -x "$1/console" && -f "$1/config/config.ini.php" ]]
}

matomo_version_from_files() {
  local dir="$1" ver
  if [[ -f "$dir/core/Version.php" ]]; then
    ver="$(grep -Eo "[0-9]+\.[0-9]+\.[0-9]+" "$dir/core/Version.php" | head -n1 || true)"
    [[ -n "$ver" ]] && { printf '%s\n' "$ver"; return 0; }
  fi
  printf 'unknown\n'
}

# ---- Runtime dispatch for ./console -----------------------------------------
# runtime: host | docker-compose | docker
# docker-compose: needs COMPOSE_FILE + SERVICE + MATOMO_IN_CONTAINER (path)
# docker: needs CONTAINER + MATOMO_IN_CONTAINER (path)
RUN_RUNTIME="host"
COMPOSE_FILE=""
COMPOSE_SERVICE="app"
DOCKER_CONTAINER=""
MATOMO_IN_CONTAINER="/var/www/html"

run_console() {
  # run_console <args...>
  case "$RUN_RUNTIME" in
    host)
      ( cd "$MATOMO_DIR" && ./console "$@" )
      ;;
    docker-compose)
      require_cmd docker
      require_cmd docker compose
      [[ -f "$COMPOSE_FILE" ]] || die "compose file not found: $COMPOSE_FILE"
      docker compose -f "$COMPOSE_FILE" exec -T "$COMPOSE_SERVICE" bash -lc "cd '$MATOMO_IN_CONTAINER' && ./console \"$@\""
      ;;
    docker)
      require_cmd docker
      [[ -n "$DOCKER_CONTAINER" ]] || die "No container name/id"
      docker exec -i "$DOCKER_CONTAINER" bash -lc "cd '$MATOMO_IN_CONTAINER' && ./console \"$@\""
      ;;
    *)
      die "Unknown runtime: $RUN_RUNTIME"
      ;;
  esac
}

# ---- File deploy helpers -----------------------------------------------------
download_build() {
  local ver="$1" out="$2"
  local url
  if [[ "$ver" == "latest" ]]; then
    url="https://builds.matomo.org/matomo.zip"
  else
    url="https://builds.matomo.org/matomo-${ver}.zip"
  fi
  info "Downloading ${ver} from: $url"
  curl -fL --retry 3 -o "$out" "$url"
}

deploy_zip_into_dir() {
  local zip="$1" dest="$2"
  require_cmd unzip
  require_cmd rsync
  local tmpd
  tmpd="$(mktemp -d)"
  trap 'rm -rf "$tmpd"' RETURN
  unzip -q "$zip" -d "$tmpd"
  # zip extracts to ./matomo/
  rsync -a --delete --exclude='config/config.ini.php' --exclude='tmp/*' --exclude='misc/user/*' "$tmpd/matomo/" "$dest/"
}

# ---- Maintenance helpers -----------------------------------------------------
maintenance_on() {
  info "Setting maintenance_mode=1"
  run_console config:set --section=General --key=maintenance_mode --value=1 >/dev/null
  info "Pausing tracking (record_statistics=0)"
  run_console config:set --section=Tracker --key=record_statistics --value=0 >/dev/null
}
maintenance_off() {
  info "Clearing maintenance_mode"
  run_console config:set --section=General --key=maintenance_mode --value=0 >/dev/null || true
  info "Resuming tracking (record_statistics=1)"
  run_console config:set --section=Tracker --key=record_statistics --value=1 >/dev/null || true
}

# ---- Begin ------------------------------------------------------------------
require_cmd curl

# Detect / prompt Matomo dir (host path, even for docker if bind-mounted)
MATOMO_DIR="${MATOMO_DIR:-}"
if [[ -z "${MATOMO_DIR}" || ! -d "${MATOMO_DIR}" ]]; then
  # rough guess
  for guess in "$PWD" "$PWD/matomo" "/var/www/html/matomo"; do
    if is_matomo_dir "$guess"; then MATOMO_DIR="$guess"; break; fi
  done
fi

while true; do
  MATOMO_DIR="$(prompt "Enter Matomo directory (must contain ./console and config/config.ini.php)" "${MATOMO_DIR:-}")"
  if [[ -z "$MATOMO_DIR" ]]; then continue; fi
  if is_matomo_dir "$MATOMO_DIR"; then break; fi
  warn "Not a Matomo install (missing console or config/config.ini.php)."
done
info "Using MATOMO_DIR: $MATOMO_DIR"

CURRENT_VERSION="$(matomo_version_from_files "$MATOMO_DIR")"
info "Your current version is: ${CURRENT_VERSION}"

# Runtime selection
RUN_RUNTIME="$(prompt "Runtime (host/docker-compose/docker)" "${RUN_RUNTIME}")"
case "$RUN_RUNTIME" in
  host) : ;;
  docker-compose)
    require_cmd docker
    require_cmd docker compose
    COMPOSE_FILE="$(prompt "Path to docker-compose.yml" "${COMPOSE_FILE:-./docker-compose.yml}")"
    [[ -f "$COMPOSE_FILE" ]] || die "compose file not found: $COMPOSE_FILE"
    COMPOSE_SERVICE="$(prompt "Service name that runs Matomo" "${COMPOSE_SERVICE:-app}")"
    MATOMO_IN_CONTAINER="$(prompt "Path to Matomo inside container" "${MATOMO_IN_CONTAINER:-/var/www/html}")"
    ;;
  docker)
    require_cmd docker
    DOCKER_CONTAINER="$(prompt "Container name or ID for Matomo" "${DOCKER_CONTAINER:-matomo}")"
    MATOMO_IN_CONTAINER="$(prompt "Path to Matomo inside container" "${MATOMO_IN_CONTAINER:-/var/www/html}")"
    ;;
  *)
    die "Invalid runtime"
    ;;
esac

# Warn if code not bind-mounted when runtime is docker/docker-compose
if [[ "$RUN_RUNTIME" != "host" ]]; then
  if [[ ! -e "$MATOMO_DIR/core/Version.php" ]]; then
    die "The host path '$MATOMO_DIR' doesn't look like a Matomo code directory.
If your code lives inside the image (no bind mount), rebuild the image instead of using this script."
  fi
fi

BACKUP_DIR="$(prompt "Backup directory" "/var/backups/matomo-upgrades")"
MATOMO_USER="$(prompt "System user that owns/runs Matomo" "$(id -un)")"

OPERATION="$(prompt "Operation (upgrade/downgrade)" "upgrade")"
TARGET_VER="$(prompt "Target version (e.g. 5.5.1) or leave empty for latest" "")"
AUTO_STEPS="$(prompt "Auto incremental upgrade across majors? [yes/no]" "no")"

RUN_DB_UPDATE="$(prompt "Run DB update via core:update? [yes/no]" "yes")"
ENABLE_MAINT="$(prompt "Enable maintenance mode during operation? [yes/no]" "yes")"
DRY_RUN="$(prompt "Dry run only (show actions, no changes)? [yes/no]" "no")"
RUN_DIAG="$(prompt "Run diagnostics:unexpected-files after deploy? [yes/no]" "yes")"
VERBOSE="$(prompt "Verbose shell output (set -x)? [yes/no]" "no")"

[[ "$VERBOSE" == "yes" ]] && set -x
[[ "$DRY_RUN" == "yes" ]] && info "DRY RUN enabled — no changes will be applied."

# Compute target sequence
remote_latest="$(curl -fsSL https://api.github.com/repos/matomo-org/matomo/releases/latest | grep -Eo '"tag_name":\s*"[^"]+"' | grep -Eo '[0-9]+(\.[0-9]+){2}' | head -n1 || true)"
[[ -z "$remote_latest" ]] && remote_latest="latest"
info "Remote latest is: ${remote_latest}"

if [[ -z "$TARGET_VER" ]]; then
  TARGET_VER="latest"
fi

if [[ "$TARGET_VER" == "$CURRENT_VERSION" || ( "$TARGET_VER" == "latest" && "$remote_latest" == "$CURRENT_VERSION" ) ]]; then
  read -r -p "Target equals current (${CURRENT_VERSION}). Continue anyway? [y/N]: " ans || true
  [[ "${ans,,}" == "y" ]] || die "Aborted."
fi

sequence=()
if [[ "$OPERATION" == "upgrade" ]]; then
  if [[ "$AUTO_STEPS" == "yes" && "$TARGET_VER" == "latest" ]]; then
    # naive incremental to latest minor if a major bump (keeps simple)
    sequence+=("$remote_latest")
  else
    sequence+=("$TARGET_VER")
  fi
else
  # downgrade: code-only
  info "Selected operation: DOWNGRADE (code-only). Database schema downgrades are not supported."
  read -r -p "Proceed with code-only rollback to ${TARGET_VER}? core:update will NOT run. [y/N]: " ans || true
  [[ "${ans,,}" == "y" ]] || die "Aborted."
  sequence+=("$TARGET_VER")
  RUN_DB_UPDATE="no"
fi

info "Planned sequence: ${sequence[*]}"

# Ensure backup dir
if [[ "$DRY_RUN" != "yes" ]]; then
  mkdir -p "$BACKUP_DIR" || die "Cannot create backup dir: $BACKUP_DIR"
fi

# STEP 1: maintenance on
if [[ "$ENABLE_MAINT" == "yes" ]]; then
  step "1/7" "Enabling maintenance mode and pausing tracking"
  if [[ "$DRY_RUN" != "yes" ]]; then
    maintenance_on || warn "Failed to enable maintenance (continuing)"
  else
    info "[dry-run] would enable maintenance + pause tracking"
  fi
fi

# STEP 2: backup config
step "2/7" "Backing up config.ini.php"
if [[ "$DRY_RUN" != "yes" ]]; then
  cp -a "$MATOMO_DIR/config/config.ini.php" "$BACKUP_DIR/config.ini.php.$(date +%F-%H%M%S)"
  info "Backed up to $BACKUP_DIR"
else
  info "[dry-run] would copy $MATOMO_DIR/config/config.ini.php -> $BACKUP_DIR"
fi

# STEP 3 & 4: download + deploy
i=3
for tgt in "${sequence[@]}"; do
  step "${i}/7" "Downloading and deploying Matomo build: ${tgt}"
  if [[ "$DRY_RUN" == "yes" ]]; then
    info "[dry-run] would download ${tgt} and rsync into $MATOMO_DIR"
  else
    tmpzip="$(mktemp)"
    trap 'rm -f "$tmpzip"' RETURN
    download_build "$tgt" "$tmpzip"
    info "Extracting and syncing files"
    deploy_zip_into_dir "$tmpzip" "$MATOMO_DIR"
  fi

  # STEP 5: DB update (only on upgrade)
  ((i++))
  if [[ "$OPERATION" == "upgrade" && "$RUN_DB_UPDATE" == "yes" ]]; then
    step "${i}/7" "Running database migrations (core:update)"
    if [[ "$DRY_RUN" == "yes" ]]; then
      info "[dry-run] would run ./console core:update --yes"
    else
      set +e
      if ! run_console core:update --yes; then
        set -e
        warn "core:update failed."
        info "Attempting to disable maintenance and resume tracking before exit…"
        maintenance_off || true
        exit 1
      fi
      set -e
    fi
  fi
  ((i++))
done

# STEP last-1: diagnostics
step "6/7" "Diagnostics (unexpected files)"
if [[ "$RUN_DIAG" == "yes" ]]; then
  if [[ "$DRY_RUN" == "yes" ]]; then
    info "[dry-run] would run diagnostics:unexpected-files"
  else
    run_console diagnostics:unexpected-files || warn "diagnostics failed"
  fi
else
  info "Skipped."
fi

# STEP last: maintenance off
if [[ "$ENABLE_MAINT" == "yes" ]]; then
  step "7/7" "Disabling maintenance and resuming tracking"
  if [[ "$DRY_RUN" == "yes" ]]; then
    info "[dry-run] would unset maintenance + resume tracking"
  else
    maintenance_off || warn "Failed to disable maintenance"
  fi
fi

info "All done."
