#!/usr/bin/env bash
# Matomo upgrader / downgrader helper
# Works on bash; do not run with sh.
set -Eeuo pipefail

# -------- utilities --------
say() { printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$*"; }
step() { printf '[%(%Y-%m-%d %H:%M:%S)T] [STEP %s] %s\n' -1 "$1" "$2"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
run() {
  local desc="$1"; shift
  step "$CURRENT_STEP/$TOTAL_STEPS" "$desc"
  if [[ "${DRY_RUN}" == "yes" ]]; then
    printf '→ DRY RUN: %q ' "$@"; printf '\n'
    return 0
  fi
  "$@"
}

trim() { awk '{$1=$1;print}' <<<"$1"; }

# -------- detection & prompts --------
is_matomo_dir() { [[ -x "$1/console" && -f "$1/config/config.ini.php" ]]; }

detect_matomo_dir() {
  if is_matomo_dir "."; then pwd; return 0; fi
  if is_matomo_dir "/var/www/html/matomo"; then echo "/var/www/html/matomo"; return 0; fi
  # try parent paths up to 3 levels
  local d
  for d in ".." "../.." "../../.."; do
    if is_matomo_dir "$d"; then (cd "$d" && pwd); return 0; fi
  done
  echo ""
}

prompt_matomo_dir() {
  local detected; detected="$(detect_matomo_dir || true)"
  if [[ -n "$detected" ]]; then
    echo "Detected Matomo at: $detected"
    read -r -p "Use this path? [Y/n]: " ans
    ans="${ans:-Y}"
    if [[ "$ans" =~ ^[Yy]$ ]]; then MATOMO_DIR="$detected"; fi
  fi

  while :; do
    if [[ -z "${MATOMO_DIR:-}" ]]; then
      read -r -p "Enter Matomo directory (must contain ./console and config/config.ini.php): " MATOMO_DIR
    fi
    MATOMO_DIR="$(trim "${MATOMO_DIR:-}")"
    MATOMO_DIR="${MATOMO_DIR%/}"
    if [[ -z "$MATOMO_DIR" ]]; then echo "Path cannot be empty."; MATOMO_DIR=""; continue; fi
    if [[ ! -d "$MATOMO_DIR" ]]; then echo "Directory not found: $MATOMO_DIR"; MATOMO_DIR=""; continue; fi
    if ! is_matomo_dir "$MATOMO_DIR"; then echo "This does not look like a Matomo install: $MATOMO_DIR"; MATOMO_DIR=""; continue; fi
    break
  done
  echo "Using MATOMO_DIR: $MATOMO_DIR"
}

# -------- version helpers --------
current_version() {
  # Prefer PHP to ask Matomo, fallback to parsing Version.php
  if [[ -x "$MATOMO_DIR/console" ]]; then
    (cd "$MATOMO_DIR" && php -d detect_unicode=0 -d short_open_tag=0 ./console core:version 2>/dev/null | awk 'NF{print $NF;exit}') || true
  fi
}

parse_version_major() { awk -F. '{print $1}' <<<"$1"; }
parse_version_minor() { awk -F. '{print $2}' <<<"$1"; }

latest_remote_version() {
  # Ask builds.matomo.org for LATEST. We tolerate failure and return "latest".
  local v
  v="$(curl -fsS https://builds.matomo.org/LATEST 2>/dev/null || true)"
  v="$(trim "${v:-}")"
  if [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then echo "$v"; else echo "latest"; fi
}

zip_url_for_version() {
  local v="$1"
  if [[ "$v" == "latest" ]]; then
    echo "https://builds.matomo.org/matomo.zip"
  else
    echo "https://builds.matomo.org/matomo-$v.zip"
  fi
}

plan_sequence() {
  # Given CURRENT and TARGET plus AUTO_INCREMENTAL, echo a space-separated sequence
  local cur="$1" tgt="$2" inc="$3"
  if [[ "$tgt" == "latest" ]]; then
    if [[ "$inc" == "yes" && "$cur" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      # Try to hop major-by-major: LATEST_<major_of_cur>, then LATEST (best-effort)
      local major; major="$(parse_version_major "$cur")"
      local hop="latest"
      # Matomo publishes LATEST_5 for v5 line. Build that name if useful.
      if [[ "$major" =~ ^[0-9]+$ && "$major" -ge 4 ]]; then
        # If already on 5.x this will still pull latest 5 then latest
        echo "latest_$major latest"
        return 0
      fi
      echo "latest"
      return 0
    else
      echo "latest"
      return 0
    fi
  fi
  echo "$tgt"
}

resolve_latest_alias() {
  # translate latest_5 -> actual version if available; else keep alias
  local alias="$1"
  if [[ "$alias" =~ ^latest_([0-9]+)$ ]]; then
    local m="${BASH_REMATCH[1]}"
    local v
    v="$(curl -fsS "https://builds.matomo.org/LATEST_$m" 2>/dev/null || true)"
    v="$(trim "${v:-}")"
    if [[ "$v" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then echo "$v"; else echo "$alias"; fi
  else
    echo "$alias"
  fi
}

# -------- maintenance & config --------
set_config() {
  local section="$1" key="$2" val="$3"
  run "Setting [$section] $key = \"$val\"" "$MATOMO_DIR/console" config:set --section="$section" --key="$key" --value="$val" >/dev/null
  echo "done."
}

enable_maintenance_and_pause() {
  set_config "General" "maintenance_mode" "1"
  set_config "Tracker" "record_statistics" "0"
  echo "✓ Maintenance enabled and tracking paused"
}

disable_maintenance_and_resume() {
  set_config "General" "maintenance_mode" "0"
  set_config "Tracker" "record_statistics" "1"
  echo "✓ Maintenance disabled and tracking resumed"
}

# -------- deploy --------
deploy_zip_into_matomo() {
  local version_label="$1"
  local url="$2"
  local tmpd; tmpd="$(mktemp -d)"
  trap 'rm -rf "$tmpd"' RETURN

  say "Downloading $version_label from: $url"
  if [[ "$DRY_RUN" == "yes" ]]; then
    echo "→ DRY RUN: would curl and unzip to temp, then rsync into $MATOMO_DIR"
    return 0
  fi

  curl -fL --retry 3 -o "$tmpd/matomo.zip" "$url"
  unzip -q -o "$tmpd/matomo.zip" -d "$tmpd"
  rsync -a --delete "$tmpd/matomo/" "$MATOMO_DIR/"
}

backup_config() {
  mkdir -p "$BACKUP_DIR"
  local ts; ts="$(date +%Y-%m-%d-%H%M%S)"
  cp -p "$MATOMO_DIR/config/config.ini.php" "$BACKUP_DIR/config.ini.php.$ts"
  echo "✓ Backed up to $BACKUP_DIR/config.ini.php.$ts"
}

run_core_update() {
  run "Running database migrations (core:update)" "$MATOMO_DIR/console" core:update --yes || true
}

run_unexpected_files() {
  run "Scanning for unexpected files" "$MATOMO_DIR/console" diagnostics:unexpected-files || true
}

# -------- main flow --------
MATOMO_DIR="${MATOMO_DIR:-}"
BACKUP_DIR="${BACKUP_DIR:-/var/backups/matomo-upgrades}"
RUN_DB_UPDATE="${RUN_DB_UPDATE:-yes}"
ENABLE_MAINTENANCE="${ENABLE_MAINTENANCE:-yes}"
AUTO_INCREMENTAL="${AUTO_INCREMENTAL:-no}"
DRY_RUN="${DRY_RUN:-no}"
RUN_UNEXPECTED="${RUN_UNEXPECTED:-yes}"
VERBOSE="${VERBOSE:-no}"
OPERATION="${OPERATION:-upgrade}"    # or downgrade
TARGET_VERSION="${TARGET_VERSION:-}"  # e.g. 5.5.1 or latest

if [[ "${VERBOSE}" == "yes" ]]; then set -x; fi

prompt_matomo_dir

say "Your current version is: $(current_version || echo unknown)"

read -r -p "Backup directory [$BACKUP_DIR]: " ans; BACKUP_DIR="${ans:-$BACKUP_DIR}"
read -r -p "System user that owns/runs Matomo [$(id -un)]: " ans; MATOMO_USER="${ans:-$(id -un)}"
read -r -p "Operation (upgrade/downgrade) [upgrade]: " ans; OPERATION="${ans:-upgrade}"
read -r -p "Target version (e.g. 5.5.1) or leave empty for latest: " ans; TARGET_VERSION="${ans:-}"
read -r -p "Auto incremental upgrade across majors? [yes/no, default no]: " ans; AUTO_INCREMENTAL="${ans:-no}"
read -r -p "Run DB update via core:update? [yes/no, default yes]: " ans; RUN_DB_UPDATE="${ans:-yes}"
read -r -p "Enable maintenance mode during operation? [yes/no, default yes]: " ans; ENABLE_MAINTENANCE="${ans:-yes}"
read -r -p "Dry run only (show actions, no changes)? [yes/no, default no]: " ans; DRY_RUN="${ans:-no}"
read -r -p "Run diagnostics:unexpected-files after deploy? [yes/no, default yes]: " ans; RUN_UNEXPECTED="${ans:-yes}"
read -r -p "Verbose shell output (set -x)? [yes/no, default no]: " ans; VERBOSE="${ans:-no}"
if [[ "${VERBOSE}" == "yes" ]]; then set -x; fi

CUR_VER="$(current_version || true)"
if [[ -z "${TARGET_VERSION}" ]]; then
  TARGET_VERSION="latest"
fi

# plan sequence
SEQ="$(plan_sequence "${CUR_VER:-}" "${TARGET_VERSION}" "${AUTO_INCREMENTAL}")"
say "Planned sequence: $SEQ"

# same-version confirmation when applicable
if [[ "${TARGET_VERSION}" != "latest" && -n "${CUR_VER:-}" && "${CUR_VER}" == "${TARGET_VERSION}" ]]; then
  read -r -p "You are already on ${CUR_VER}. Continue and redeploy the same version? [y/N]: " ans
  ans="${ans:-N}"
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    die "Aborted by user."
  fi
fi

# Downgrade warning
if [[ "$OPERATION" == "downgrade" ]]; then
  echo "! Selected operation: DOWNGRADE (code-only). Database schema downgrades are not supported."
  read -r -p "Proceed with code-only rollback to ${TARGET_VERSION}? core:update will NOT run. [y/N]: " ans
  ans="${ans:-N}"
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then die "Aborted by user."; fi
fi

# steps count
TOTAL_STEPS=7
CURRENT_STEP=1

if [[ "$ENABLE_MAINTENANCE" == "yes" ]]; then
  run "Enabling maintenance mode and pausing tracking" enable_maintenance_and_pause
else
  step "$CURRENT_STEP/$TOTAL_STEPS" "Skipping maintenance toggle"
fi
CURRENT_STEP=$((CURRENT_STEP+1))

run "Backing up config.ini.php" backup_config
CURRENT_STEP=$((CURRENT_STEP+1))

# loop through sequence
for planned in $SEQ; do
  CURRENT_STEP=$((CURRENT_STEP)) # keep within 3..6 block

  # resolve alias like latest_5 to real version if possible
  RESOLVED="$(resolve_latest_alias "$planned")"
  URL="$(zip_url_for_version "$RESOLVED")"

  run "Downloading and deploying Matomo build: $planned" deploy_zip_into_matomo "$planned" "$URL"
  CURRENT_STEP=$((CURRENT_STEP+1))

  if [[ "$OPERATION" == "upgrade" && "$RUN_DB_UPDATE" == "yes" ]]; then
    run "Running database migrations (core:update)" run_core_update
  else
    step "$CURRENT_STEP/$TOTAL_STEPS" "Skipping DB migrations"
  fi
  CURRENT_STEP=$((CURRENT_STEP+1))
done

if [[ "$RUN_UNEXPECTED" == "yes" ]]; then
  run "Running diagnostics:unexpected-files" run_unexpected_files
else
  step "$CURRENT_STEP/$TOTAL_STEPS" "Skipping diagnostics:unexpected-files"
fi
CURRENT_STEP=$((CURRENT_STEP+1))

if [[ "$ENABLE_MAINTENANCE" == "yes" ]]; then
  run "Disabling maintenance mode and resuming tracking" disable_maintenance_and_resume
else
  step "$CURRENT_STEP/$TOTAL_STEPS" "Leaving maintenance and tracking as-is"
fi
CURRENT_STEP=$((CURRENT_STEP+1))

say "Done. Current version now: $(current_version || echo unknown)"
exit 0
